<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F3"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍲 Suggested Recipes"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#174D36"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can make with your pantry ingredients."
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/tvEmptyRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No recipes available yet. Add the required ingredients and quantities to your pantry."
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDE5DC"
        android:dividerHeight="1dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnRecipesBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:textAllCaps="false"
        android:backgroundTint="#174D36"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

</LinearLayout>
